---
import { url } from "../lib/url";
import Seal from "./Seal.astro";

interface Props { current?: "home" | "search" | "map" }
const { current } = Astro.props;

const nav = [
  { key: "home",   no: "01", jp: "目録", en: "Index",  href: url() },
  { key: "search", no: "02", jp: "検索", en: "Search", href: url("search") },
  { key: "map",    no: "03", jp: "地図", en: "Map",    href: url("map") },
] as const;
---

<header class="hd" id="hd">
  <a class="brand" href={url()} aria-label="うまい店だけ。トップへ">
    <Seal size="34px" />
    <span class="brand-t">
      <b>うまい店だけ。</b>
      <small class="mono">Only the good ones</small>
    </span>
  </a>

  <nav class="gnav" aria-label="メイン">
    {nav.map((n) => (
      <a href={n.href} aria-current={current === n.key ? "page" : undefined}>
        <sup class="mono">{n.no}</sup>
        <span class="roll" data-text={n.jp}><span>{n.jp}</span></span>
      </a>
    ))}
  </nav>

  <button type="button" class="btn btn-ink hd-cta" data-random data-magnetic>
    <span class="roll" data-text="今日の一軒を引く"><span>今日の一軒を引く</span></span>
    <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="3" width="14" height="14" rx="3" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="7.2" cy="7.2" r="1.3"/><circle cx="12.8" cy="12.8" r="1.3"/><circle cx="12.8" cy="7.2" r="1.3"/><circle cx="7.2" cy="12.8" r="1.3"/></svg>
  </button>

  <button type="button" class="menu-btn mono" id="menuBtn" aria-expanded="false" aria-controls="menu">
    <span>Menu</span><i></i>
  </button>
</header>

<div class="menu" id="menu" hidden>
  <nav aria-label="メニュー">
    {nav.map((n) => (
      <a href={n.href} aria-current={current === n.key ? "page" : undefined}>
        <sup class="mono">{n.no}</sup><span class="ln"><span class="ln-i">{n.jp}<em class="it">{n.en}</em></span></span>
      </a>
    ))}
  </nav>
  <button type="button" class="btn btn-ink" data-random>今日の一軒を引く</button>
</div>
