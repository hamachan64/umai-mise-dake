---
import Base from "../layouts/Base.astro";
import ShopRow from "../components/ShopRow.astro";
import { SHOPS, GENRE_LIST, AREA_LIST, BUDGET_BANDS, SCORE_MAX, bandOf, kanjiOf, toneOf, scoreLabel } from "../data/shops";
import { url } from "../lib/url";

const countGenre = (g: string) => SHOPS.filter((s) => s.genre === g).length;
const countArea  = (a: string) => SHOPS.filter((s) => s.area === a).length;
const countBand  = (b: string) => SHOPS.filter((s) => bandOf(s.budget) === b).length;
const countScore = (min: number) => SHOPS.filter((s) => s.score >= min).length;
const areas = [...AREA_LIST].sort((a, b) => countArea(b) - countArea(a) || a.localeCompare(b, "ja"));
---

<Base
  title="詳細検索｜うまい店だけ。"
  description="ジャンル・エリア・予算・推し度・キーワードから、条件を組み合わせて店を探せます。"
  current="search"
>
  <main id="main">
    <section class="phero shell">
      <div class="phero-grid">
        <p class="mono eyebrow" data-fade><span class="dot"></span>Advanced search<span class="dim">— 02</span></p>
        <h1 data-lines><span class="ln"><span class="ln-i">検索</span></span><span class="it">Search</span></h1>
        <p class="phero-lede" data-fade="0.15">条件は組み合わせられます。絞った状態のURLは、そのまま共有やブックマークに使えます。</p>
      </div>
    </section>

    <div class="shell">
      <form class="sform" id="sform" autocomplete="off" data-fade="0.2">
        <label class="qbox">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" /></svg>
          <span class="sr" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">キーワード</span>
          <input type="search" id="q" name="q" placeholder="煮干し、ひとり、コハダ…" />
          <kbd>/</kbd>
        </label>

        <div class="sgrid">
          <fieldset data-group="genre">
            <legend><b>ジャンル</b><span class="mono">Genre</span><button type="button" class="clr mono" data-clear="genre">Clear</button></legend>
            <div class="opts">
              {GENRE_LIST.map((g) => (
                <label class="opt" style={`--tone:var(--${toneOf(g)})`}>
                  <input type="checkbox" name="genre" value={g} />
                  <span><b class="gl" aria-hidden="true">{kanjiOf(g)}</b>{g}<i>{countGenre(g)}</i></span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset data-group="area">
            <legend><b>エリア</b><span class="mono">Area</span><button type="button" class="clr mono" data-clear="area">Clear</button></legend>
            <div class="opts scroll" data-lenis-prevent>
              {areas.map((a) => (
                <label class="opt">
                  <input type="checkbox" name="area" value={a} />
                  <span>{a}<i>{countArea(a)}</i></span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset data-group="band">
            <legend><b>予算</b><span class="mono">Budget</span><button type="button" class="clr mono" data-clear="band">Clear</button></legend>
            <div class="opts">
              {BUDGET_BANDS.map((b) => (
                <label class="opt">
                  <input type="checkbox" name="band" value={b.id} />
                  <span>{b.label}<i>{countBand(b.id)}</i></span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset data-group="score">
            <legend><b>推し度</b><span class="mono">Score</span></legend>
            <div class="opts">
              {[0, 3, 4, 5].map((v) => (
                <label class="opt">
                  <input type="radio" name="score" value={String(v)} checked={v === 0} />
                  <span>
                    {v === 0 ? "すべて" : v === SCORE_MAX ? `${scoreLabel(v)}だけ` : `${scoreLabel(v)}以上`}
                    <i>{v ? `${v}/${SCORE_MAX}〜 · ` : ""}{countScore(v)}</i>
                  </span>
                </label>
              ))}
            </div>
          </fieldset>
        </div>
      </form>

      <div class="sbar">
        <p class="count"><b id="shown">{SHOPS.length}</b><span class="mono">/ {SHOPS.length} shops</span></p>
        <div class="sbar-r">
          <a class="link" href={url("search")} id="reset">条件をリセット</a>
          <span class="select">
            <select id="sort" aria-label="並び替え">
              <option value="score">推し度が高い順</option>
              <option value="budget-asc">予算が安い順</option>
              <option value="budget-desc">予算が高い順</option>
              <option value="name">店名順</option>
            </select>
          </span>
        </div>
      </div>

      <div class="rows" id="grid">
        {SHOPS.map((s) => <ShopRow shop={s} />)}
      </div>

      <div class="empty" id="nores" hidden>
        <b aria-hidden="true">無</b>
        <p>条件に合うお店が見つかりませんでした。</p>
        <small>キーワードを短くするか、チェックを減らしてみてください。</small>
      </div>

      <div class="sfoot">
        <a class="btn btn-ink" id="tomap" href={url("map")} data-magnetic>
          <span class="roll" data-text="この条件を地図で見る"><span>この条件を地図で見る</span></span><span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </main>
</Base>

<script>
  import { gsap, $, $$, reduce, scrollToEl, ScrollTrigger, EASE_OUT } from "../scripts/motion";

  const form  = $<HTMLFormElement>("#sform");
  const q     = $<HTMLInputElement>("#q");
  const sort  = $<HTMLSelectElement>("#sort");
  const grid  = $("#grid");
  const cards = $$<HTMLElement>(".row", grid);

  const checked = (name: string) =>
    $$<HTMLInputElement>(`input[name="${name}"]:checked`).map((i) => i.value);

  /* ---- URL → フォーム（読み込み時と戻る操作） ---- */
  function readUrl() {
    const p = new URLSearchParams(location.search);
    q.value = p.get("q") ?? "";
    for (const name of ["genre", "area", "band"]) {
      const want = new Set((p.get(name) ?? "").split(",").filter(Boolean));
      $$<HTMLInputElement>(`input[name="${name}"]`).forEach((i) => { i.checked = want.has(i.value); });
    }
    const sc = p.get("score") ?? "0";
    $$<HTMLInputElement>('input[name="score"]').forEach((i) => { i.checked = i.value === sc; });
    sort.value = p.get("sort") ?? "score";
  }

  /* ---- フォーム → URL ---- */
  function writeUrl() {
    const p = new URLSearchParams();
    if (q.value.trim()) p.set("q", q.value.trim());
    for (const name of ["genre", "area", "band"]) {
      const v = checked(name);
      if (v.length) p.set(name, v.join(","));
    }
    const sc = checked("score")[0];
    if (sc && sc !== "0") p.set("score", sc);
    if (sort.value !== "score") p.set("sort", sort.value);
    const qs = p.toString();
    history.replaceState(null, "", qs ? `?${qs}` : location.pathname);

    // 「この条件を地図で見る」に今の条件を引き継ぐ
    const toMap = $<HTMLAnchorElement>("#tomap");
    toMap.href = toMap.pathname + (qs ? `?${qs}` : "");
  }

  /* ---- 絞り込み＋並び替え ---- */
  let first = true;
  function apply() {
    const words = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    const g = new Set(checked("genre"));
    const a = new Set(checked("area"));
    const b = new Set(checked("band"));
    const minScore = Number(checked("score")[0] ?? 0);

    const before = new Set(cards.filter((c) => !c.hidden));
    let shown = 0;
    cards.forEach((c) => {
      const d = c.dataset;
      const ok =
        (!g.size || g.has(d.genre!)) &&
        (!a.size || a.has(d.area!)) &&
        (!b.size || b.has(d.band!)) &&
        Number(d.score) >= minScore &&
        words.every((w) => d.q!.includes(w));
      c.hidden = !ok;
      if (ok) shown++;
    });

    // 並び替えは表示中の行をDOMごと並べ替える
    const dir = sort.value;
    const key = (c: HTMLElement) => {
      const d = c.dataset;
      if (dir === "budget-asc")  return Number(d.budget);
      if (dir === "budget-desc") return -Number(d.budget);
      if (dir === "name")        return d.name!;
      return -Number(d.score) * 1e6 + Number(d.budget); // 推し度→予算安い順
    };
    [...cards]
      .sort((x, y) => {
        const kx = key(x), ky = key(y);
        return typeof kx === "string" ? kx.localeCompare(ky as string, "ja") : kx - (ky as number);
      })
      .forEach((c) => grid.append(c));

    // 新しく出てきた行だけ、そっと持ち上げる
    if (!first && !reduce) {
      const entered = cards.filter((c) => !c.hidden && !before.has(c)).slice(0, 12);
      gsap.fromTo(entered, { autoAlpha: 0, y: 20 }, { autoAlpha: 1, y: 0, duration: 0.9, ease: EASE_OUT, stagger: 0.03, overwrite: true });
    }
    first = false;

    const el = $("#shown");
    const o = { v: Number(el.textContent) };
    gsap.to(o, { v: shown, duration: reduce ? 0 : 0.6, ease: "power3.out", overwrite: true, onUpdate: () => { el.textContent = String(Math.round(o.v)); } });
    $("#nores").hidden = shown > 0;
    grid.hidden = shown === 0;
    $$("fieldset[data-group]").forEach((f) => f.classList.toggle("has", !!checked(f.dataset.group!).length));
    writeUrl();
    ScrollTrigger.refresh();
  }

  form.addEventListener("input", apply);
  form.addEventListener("submit", (e) => e.preventDefault());
  sort.addEventListener("change", apply);
  addEventListener("popstate", () => { readUrl(); apply(); });

  $$("[data-clear]").forEach((btn) => btn.addEventListener("click", () => {
    $$<HTMLInputElement>(`input[name="${btn.dataset.clear}"]`).forEach((i) => { i.checked = false; });
    apply();
  }));

  // 「/」でキーワード欄へ
  addEventListener("keydown", (e) => {
    if (e.key === "/" && document.activeElement !== q && !(e.target as HTMLElement).closest("input,select,textarea")) {
      e.preventDefault(); q.focus();
    }
  });

  $("#reset").addEventListener("click", (e) => {
    e.preventDefault();
    form.reset();
    $$<HTMLInputElement>('input[name="score"]')[0]!.checked = true;
    sort.value = "score";
    apply();
    scrollToEl(0);
  });

  readUrl();
  apply();
</script>
